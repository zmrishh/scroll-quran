# RevenueCat public SDK keys: RevenueCat dashboard → Project settings → API keys.
# They are made to ship inside the app, so this file is committed and EAS Build picks it up.
# Left empty, the paywall runs in demo mode (development only; release builds won't unlock).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
