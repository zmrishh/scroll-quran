# RevenueCat public SDK keys: RevenueCat dashboard → Project settings → API keys.
# They are made to ship inside the app, so this file is committed and EAS Build picks it up.
# Left empty, the paywall runs in demo mode (development only; release builds won't unlock).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Google sign-in on iOS: the iOS OAuth client ID from Google Cloud (ends in .apps.googleusercontent.com).
# Android needs nothing here, only an Android OAuth client with the app's SHA-1 in the same Google Cloud project.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
